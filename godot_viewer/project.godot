; Godot 4.x project file. Open this folder from Godot's "Import" button.

config_version=5

[application]

config/name="vxw_viewer"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.15, 0.17, 0.2, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.15, 0.17, 0.2, 1)
